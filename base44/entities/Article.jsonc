{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "excerpt": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "membre",
        "non-membre"
      ],
      "description": "Qui peut voir ce contenu"
    }
  },
  "required": [
    "title",
    "body",
    "visibility"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
