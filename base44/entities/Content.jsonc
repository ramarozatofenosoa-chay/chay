{
  "name": "Content",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "audio",
        "video",
        "predication",
        "enseignement",
        "annonce",
        "evenement",
        "actualite",
        "autre"
      ],
      "default": "autre"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "media_url": {
      "type": "string"
    },
    "resource_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "type",
    "title",
    "status"
  ],
  "rls": {
    "read": null,
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}