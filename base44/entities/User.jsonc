{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user",
        "moderator"
      ]
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "gender": {
      "type": "string",
      "enum": [
        "Homme",
        "Femme"
      ]
    },
    "phone": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "profile_photo_url": {
      "type": "string"
    },
    "location_lat": {
      "type": "number"
    },
    "location_lng": {
      "type": "number"
    },
    "location_label": {
      "type": "string"
    },
    "localisation_activee": {
      "type": "boolean"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "birth_place": {
      "type": "string"
    },
    "conversion_date": {
      "type": "string",
      "format": "date"
    },
    "baptized": {
      "type": "boolean"
    },
    "baptism_date": {
      "type": "string",
      "format": "date"
    },
    "church": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "spiritual_journey": {
      "type": "string"
    },
    "known_chay_since": {
      "type": "string"
    },
    "accepte_commentaires_respect": {
      "type": "boolean"
    },
    "accepte_cookies": {
      "type": "boolean"
    },
    "accepte_cgu": {
      "type": "boolean"
    },
    "consents_accepted": {
      "type": "boolean"
    },
    "church_assigned": {
      "type": "string"
    },
    "bible_last_book": {
      "type": "string"
    },
    "bible_last_chapter": {
      "type": "number"
    }
  },
  "required": [
    "role"
  ]
}