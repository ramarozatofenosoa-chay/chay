{
  "name": "MusicTrack",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "album": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "enum": [
        "fr",
        "en",
        "mg"
      ],
      "default": "fr"
    },
    "cover_url": {
      "type": "string"
    },
    "audio_url": {
      "type": "string"
    },
    "duration_seconds": {
      "type": "number"
    }
  },
  "required": [
    "title",
    "artist"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": null,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}