{
  "name": "WebPushSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Propri\u00e9taire de l'abonnement (identifiant utilisateur)."
    },
    "endpoint": {
      "type": "string",
      "description": "URL du service de push (PushService) pour cet appareil."
    },
    "p256dh": {
      "type": "string",
      "description": "Cl\u00e9 publique de chiffrement de l'abonnement (aes128gcm)."
    },
    "auth": {
      "type": "string",
      "description": "Secret d'authentification de l'abonnement."
    },
    "user_agent": {
      "type": "string",
      "description": "Navigateur de l'appareil (diagnostic)."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "last_seen": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}
