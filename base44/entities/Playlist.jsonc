{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_url": {
      "type": "string"
    },
    "order": {
      "type": "number",
      "description": "Position d'affichage, gérée par le glisser-déposer admin"
    },
    "category": {
      "type": "string",
      "enum": [
        "music",
        "sermons",
        "films",
        "other"
      ],
      "default": "music"
    },
    "created_by_id": {
      "type": "string",
      "description": "ID de l'utilisateur qui a cr\u00e9\u00e9 la playlist"
    }
  },
  "required": [
    "name",
    "cover_url"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}