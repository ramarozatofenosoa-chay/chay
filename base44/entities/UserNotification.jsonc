{
  "name": "UserNotification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "notification_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "default": "new_content"
    },
    "content_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string"
    },
    "content_type": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "count": {
      "type": "number",
      "default": 1
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du dernier e-mail envoy\u00e9 pour cette notification (d\u00e9duplication 30 min par conversation)."
    }
  },
  "required": [
    "user_id",
    "notification_id",
    "title"
  ],
  "rls": {
    "read": {
      "data.user_id": "{{user.id}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}