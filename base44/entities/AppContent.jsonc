{
  "name": "AppContent",
  "type": "object",
  "properties": {
    "splash_text_mg": {
      "type": "string"
    },
    "splash_text_fr": {
      "type": "string"
    },
    "about_text": {
      "type": "string"
    },
    "app_version": {
      "type": "string",
      "description": "Version la plus récente de l'application APK"
    },
    "app_apk_url": {
      "type": "string",
      "description": "URL du fichier APK de la dernière version"
    }
  },
  "required": [
    "splash_text_mg",
    "splash_text_fr"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}