{
  "appId": "io.chay.app",
  "appName": "ÉGLISE CHAY",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://chay.base44.app",
    "cleartextTraffic": false
  },
  "preferences": {
    "ShowSplash": true,
    "ShowSplashScreenSpinner": false,
    "BackgroundColor": "#4A6CFE",
    "HideNavigationBar": true,
    "StatusBarStyle": "light",
    "SplashMaintainAspectRatio": true,
    "SplashShowDelay": 0
  },
  "splash": {
    "showSplash": true,
    "autoHide": false,
    "fadeDuration": 300,
    "splashFullscreen": true
  }
}
